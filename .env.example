# VitaNova Clinic — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ── SUPABASE (Free Backend) ─────────────────────────────────────────────────────
# Step 1: Go to https://supabase.com → Sign up (free)
# Step 2: Create a new project (free tier, choose "Africa" region or "Europe" if unavailable)
# Step 3: Go to Settings → API
# Step 4: Copy your Project URL and anon/public key below

VITE_SUPABASE_URL=YOUR_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Example (replace with yours):
# VITE_SUPABASE_URL=https://abcdefghijklm.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── APP CONFIG ───────────────────────────────────────────────────────────────────
VITE_APP_NAME=VitaNova Clinic
VITE_APP_VERSION=1.0.0
